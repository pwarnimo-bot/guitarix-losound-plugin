@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:losound:redsun>
    a lv2:Plugin ;
    lv2:binary <redsun.so> ;
    rdfs:seeAlso <redsun.ttl> .

<urn:losound:redsun#green-machine>
    a pset:Preset ;
    lv2:appliesTo <urn:losound:redsun> ;
    rdfs:seeAlso <presets.ttl> .

<urn:losound:redsun#thumb>
    a pset:Preset ;
    lv2:appliesTo <urn:losound:redsun> ;
    rdfs:seeAlso <presets.ttl> .

<urn:losound:redsun#freedom-run>
    a pset:Preset ;
    lv2:appliesTo <urn:losound:redsun> ;
    rdfs:seeAlso <presets.ttl> .
