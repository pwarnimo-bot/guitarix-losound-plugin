@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<urn:losound:redsun>
    a lv2:Plugin , lv2:DistortionPlugin ;
    doap:name "LoSound Red Sun" ;
    rdfs:comment "Desert-rock fuzz into a bass amp and bass cabinet, after the early-90s Palm Desert sound." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "fuzz" ;
        lv2:name "Fuzz" ;
        lv2:default 0.75 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "octave" ;
        lv2:name "Octave" ;
        lv2:default 0.2 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bass" ;
        lv2:name "Bass" ;
        lv2:default 0.65 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "mid" ;
        lv2:name "Mid" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "treble" ;
        lv2:name "Treble" ;
        lv2:default 0.55 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "ultralo" ;
        lv2:name "Ultra Lo" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "sag" ;
        lv2:name "Sag" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "cab" ;
        lv2:name "Cab" ;
        rdfs:comment "0 = bass 8x10, 1 = guitar 4x12" ;
        lv2:default 0.15 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        units:unit units:db ;
        lv2:default -6.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 12.0
    ] .
